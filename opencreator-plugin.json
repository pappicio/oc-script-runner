{
  "id": "script-runner",
  "name": "Script Runner",
  "version": "1.0.3",
  "description": "Automatically executes user scripts in SoC and Tunneled modes.",
  "startup": [
    {
      "name": "runner",
      "exec": "bin/runner.sh",
      "type": "service"
    }
